# === Python 缓存 ===
__pycache__/
*.py[cod]
*$py.class
*.so

# === 打包/构建 ===
build/
dist/
*.egg-info/
*.egg
wheels/

# === 虚拟环境/密钥/配置 ===
.env
.envrc
.venv/
venv/
*.key
*.pem

# === 依赖锁文件（按需提交） ===
poetry.lock
pdm.lock
uv.lock

# === IDE/编辑器 ===
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.iml

# === 测试/报告 ===
.pytest_cache/
.coverage
htmlcov/

# === 日志/数据/模型（你的项目专属） ===
logs/
*.log
data/
*.csv
*.json
