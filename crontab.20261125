#0 * * * * /usr/local/bin/jitter-run.sh -m 10 -- $HOME/projects/ai_training_cnn/refresh_dashboard.sh

# ─── Maintenance ─────────────────────────────────────────────────
0 0 * * 0 cd $HOME/projects/ai_training_cnn && mv logs/bot_h4.log logs/bot_h4_$(date +\%Y\%m\%d).log && touch logs/bot_h4.log
0 3 * * 1-5 find $HOME/projects/ai_training_cnn/daily_results -name "*.json" -mtime +7 -delete
5 0 * * 1-5 cd $HOME/projects/ai_training_cnn && /home/ubuntu/miniconda3/envs/ai-sprint/bin/python retrain_model.py >> logs/bot_cron.log 2>&1
20 0 * * 1-5 cd $HOME/projects/ai_training_cnn && RETRAIN_PROFILE=2 RETRAIN_BARS=5000 FX_MODEL_STEM=models_fcv2/trade_model_xgb OPT_USE_FEATURE_CONTRACT_V2=1 /home/ubuntu/miniconda3/envs/ai-sprint/bin/python retrain_model.py >> logs/retrain_fcv2.log 2>&1

0,5,10 * * * * cd "$HOME/projects/fx_monte_carlo" && ./run_fx_mc.sh >> mc_cron.log 2>&1

0 */6 * * * cd /home/ubuntu/projects/forex_oanda_v7 && python lifecycle_shadow_eval.py >> reports/shadow_eval.log 2>&1

0 3 * * * find /home/ubuntu/projects/forex_oanda_v7/logs -name "*.log" -mtime +7 -delete
30 7 * * * cd /home/ubuntu/projects/ai_training_cnn/attribution_v2/logs && find . -name "*.jsonl" -mtime +1 -exec /usr/bin/zstd -q --rm {} \; && find . -name "*.zst" -mtime +14 -delete

